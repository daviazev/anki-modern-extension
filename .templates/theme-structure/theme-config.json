{
  "name": "{{THEME_NAME}}",
  "version": "1.0.0",
  "description": "{{THEME_DESCRIPTION}}",
  "author": "{{AUTHOR_NAME}}",
  
  "colors": {
    "primary": "#e0e5ec",
    "secondary": "#f0f4f8",
    "textPrimary": "#2c3e50",
    "textSecondary": "#6c757d",
    "accent": "#5e72e4",
    "accentHover": "#4c63d2",
    "shadowLight": "#ffffff",
    "shadowDark": "#a3b1c6",
    "success": "#28a745",
    "warning": "#ffc107",
    "danger": "#dc3545"
  },
  
  "shadows": {
    "raised": "8px 8px 16px var(--theme-shadow-dark), -8px -8px 16px var(--theme-shadow-light)",
    "pressed": "inset 4px 4px 8px var(--theme-shadow-dark), inset -4px -4px 8px var(--theme-shadow-light)",
    "hover": "12px 12px 24px var(--theme-shadow-dark), -12px -12px 24px var(--theme-shadow-light)",
    "subtle": "4px 4px 8px var(--theme-shadow-dark), -4px -4px 8px var(--theme-shadow-light)"
  },
  
  "spacing": {
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px"
  },
  
  "borderRadius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "round": "50%"
  },
  
  "fonts": {
    "primary": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "monospace": "'Fira Code', 'Courier New', monospace",
    "size": {
      "xs": "10px",
      "sm": "12px",
      "md": "14px",
      "lg": "16px",
      "xl": "20px",
      "xxl": "24px",
      "xxxl": "32px"
    },
    "weight": {
      "light": 300,
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  
  "transitions": {
    "fast": "0.15s ease",
    "normal": "0.3s ease",
    "slow": "0.5s ease"
  },
  
  "breakpoints": {
    "mobile": "768px",
    "tablet": "1024px",
    "desktop": "1440px"
  }
}
