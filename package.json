{
  "name": "anki-modern-extension",
  "displayName": "AnkiModern - Modern Theme for AnkiWeb",
  "version": "0.0.1",
  "description": "A beautiful, modern dark theme for AnkiWeb with customizable color schemes and Firebase sync",
  "author": "Davi Azevedo",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://ankiweb.net/*",
      "https://ankiuser.net/*"
    ],
    "permissions": [
      "storage",
      "tabs",
      "identity"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "AnkiModern Settings"
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.google.com https://*.firebase.com https://firestore.googleapis.com"
    },
    "oauth2": {
      "client_id": "271687689540-okluec8klap9pjt4o4ol80pfjv1efim3.apps.googleusercontent.com",
      "scopes": [
        "openid",
        "email",
        "profile"
      ]
    }
  }
}
